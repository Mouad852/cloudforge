# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
crash.*.log
# .terraform.lock.hcl is intentionally NOT ignored — commit it (pins provider versions)

# Generated at plan/apply time from templates/canary.js.tpl — not the source of truth
/terraform/modules/observability/build/
/terraform/modules/observability/build.zip

# Never commit real credentials
.env
.env.*
!.env.example

# Go
/app/bin/
/app/*.exe
/app/cloudstore

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local scratch
*.tmp
*.bak

/terraform/modules/observability/build*.zip
