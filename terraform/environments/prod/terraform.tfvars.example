environment = "prod"

instance_type        = "t4g.small" # same capacity finding as dev - see dev/terraform.tfvars.example
asg_min_size         = 2
asg_max_size         = 6
asg_desired_capacity = 2

db_multi_az                = true
db_deletion_protection     = true
db_backup_retention_period = 7
db_apply_immediately       = false

alert_email = "you@example.com"
