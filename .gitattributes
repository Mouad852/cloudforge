# Force LF regardless of platform — these run on GitHub Actions (Linux) and a
# CRLF-mangled shebang fails there silently.
*.sh text eol=lf
*.tf text eol=lf
*.go text eol=lf
Makefile text eol=lf

# Rendered into instance user_data by templatefile(). A CRLF shebang makes the
# bootstrap script fail on the instance, and makes a local plan differ from CI.
*.tpl text eol=lf

# Windows-only files
*.ps1 text eol=crlf
